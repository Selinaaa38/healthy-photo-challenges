{
  "expo": {
    "name": "Healthy Photo Challenges",
    "slug": "healthy-photo-challenges",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "healthy-photo-challenges",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Healthy Photo Challenges uses the camera so you can take a photo when you finish a challenge."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Healthy Photo Challenges uses your photos so you can check in with a picture you already took."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
